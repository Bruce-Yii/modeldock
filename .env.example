# Provider profile: opencode-go (default) or deepseek-official.
# MODELDOCK_PROFILE=opencode-go
# Upstream base URL override for the OpenCode Go camp (defaults to the go endpoint).
# MODELDOCK_UPSTREAM_BASE_URL=https://opencode.ai/zen/go/v1
# Upstream base URL override for the DeepSeek camp.
# MODELDOCK_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENCODE_GO_TOKEN=
# Token values (OPENCODE_GO_TOKEN, DEEPSEEK_API_KEY, EXA_API_KEY) are stored
# encrypted on disk on Windows as `dpapi:<base64>` (Windows current-user DPAPI).
# A copied .env is not readable on another machine or by another user. On
# non-Windows (dev/CI) they stay plaintext. An existing plaintext .env is
# migrated automatically on first gateway start, with a .plain.bak-<ts> backup.
# Token used by the deepseek-official profile (main model on DeepSeek, vision on Go).
# DEEPSEEK_API_KEY=
# Optional override for the Codex user config directory. Defaults to CODEX_HOME or ~/.codex.
# MODELDOCK_CODEX_HOME=C:\Users\you\.codex
# Where to read the env file from (first match wins):
#   1. MODELDOCK_ENV_FILE (explicit path)
#   2. MODELDOCK_CONFIG_DIR/.env
#   3. the repo root .env
# MODELDOCK_ENV_FILE=C:\Users\you\modeldock\.env
# MODELDOCK_CONFIG_DIR=C:\Users\you\modeldock
MODELDOCK_HOST=127.0.0.1
MODELDOCK_PORT=4097
# MCP transport for the managed [mcp_servers.modeldock] entry. "stdio" (default)
# spawns src/mcp-standalone.mjs as a Codex-owned child process, so gateway
# restarts never break the session's MCP tools. "url" points Codex at the
# gateway's own streamable-HTTP /mcp endpoint instead.
# MODELDOCK_MCP_TRANSPORT=stdio
MODELDOCK_MAIN_MODEL=deepseek-v4-flash
MODELDOCK_VISION_MODEL=mimo-v2.5-free
MODELDOCK_VISION_FALLBACK_MODEL=minimax-m3
MODELDOCK_VISION_TIMEOUT_MS=90000
MODELDOCK_MEDIA_TTL_MS=3600000
MODELDOCK_MEDIA_MAX_BYTES=10485760
MODELDOCK_MEDIA_MAX_ENTRIES=64
EXA_MCP_URL=https://mcp.exa.ai/mcp
EXA_API_KEY=
# Debug mode (applies to every profile): verbose gateway logs.
# MODELDOCK_DEBUG=1
# Strip the reasoning field from upstream requests (debug experiment).
# MODELDOCK_NO_REASONING=1
# Dump every transformed upstream request payload to this directory (debug).
# MODELDOCK_DUMP_DIR=C:\Users\you\modeldock-dumps
# Require the caller-key path (/c/<key>/v1) for every gateway request; the bare
# /v1 path is accepted by default so scripts can reach the gate without a key.
# MODELDOCK_REQUIRE_CALLER_KEY=1
# Hours between live model catalog refreshes (default 24).
# MODELDOCK_MODEL_REFRESH_HOURS=24
# Declared context window used as the catalog default (per-model entries can
# override it). Lower values make Codex compact sooner.
# MODELDOCK_CONTEXT_WINDOW=250000
# Recent dashboard trace records kept in memory (10-500).
# MODELDOCK_RECENT_LIMIT=50
# Gateway-side memory compression (rolling summaries, sliding window, reasoning
# clipping). Set to 0 to hand context management back to the client and compare.
# MODELDOCK_MD_MEMORY=1

# Model catalog comes from the shipped curated list in src/catalog.mjs (primary).
# Set MODELDOCK_MODEL_PROBE_ENABLED=1 to also merge the live upstream /models list at
# startup (a light GET only). Visual probing/evaluation is a dev-only test tool and
# is not enabled by default.
# MODELDOCK_MODEL_PROBE_ENABLED=1

# Native GPT models (captured from the Codex desktop CLI's bundled catalog) are
# merged into the published catalog so the App picker keeps listing them beside
# ours. The capture is cached at ~/.modeldock/native-catalog.json and refreshed
# at gateway startup; requests for those slugs pass through to ChatGPT's native
# backend. Override the cache path or disable the refresh here.
# MODELDOCK_NATIVE_CATALOG_FILE=
# MODELDOCK_REFRESH_NATIVE_CATALOG=0
